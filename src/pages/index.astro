---
import { getCollection } from 'astro:content';
import ProductCard from '../components/ProductCard.astro';
import Layout from '../layouts/Layout.astro';

const allProducts = await getCollection('products');
---
<Layout title="Local Home Bakery | Fresh Sourdough">
  <main class="max-w-6xl mx-auto px-4 py-12">
    <header class="text-center mb-12">
      <h1 class="text-5xl font-serif font-bold">Small Batch Bakery</h1>
      <p class="text-gray-500 mt-4">Baked fresh with local eggs and wild yeast.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {allProducts.map(item => (
        <ProductCard product={item.data} />
      ))}
    </div>
  </main>
</Layout>
