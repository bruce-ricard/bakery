---
const { product } = Astro.props;
---
<div class="border rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow">
  <img src={product.image} alt={product.name} class="w-full h-48 object-cover" />
  <div class="p-4">
    <div class="flex justify-between items-center">
      <h3 class="text-xl font-bold">{product.name}</h3>
      <span class="text-orange-700 font-mono font-bold">${product.price}</span>
    </div>
    <p class="text-gray-600 mt-2 text-sm">{product.description}</p>
    <a
      href={product.stripeUrl}
      class="mt-4 block text-center bg-black text-white py-2 rounded hover:bg-gray-800 transition-colors"
    >
      Order for Pickup
    </a>
  </div>
</div>
